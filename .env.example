# Infrastructure Credentials & Config
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Ansible playbook credentials (sourced by Ansible as env vars)
REDIS_PASSWORD=your_secure_redis_password_here
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# Terraform variables (can also be passed via -var flags or terraform.tfvars)
# Comma-separated list of CIDR blocks allowed to access Jenkins (8080) and K3s API (6443)
# Example: "203.0.113.0/24,198.51.100.0/25"
TF_VAR_admin_cidrs=["your.admin.ip/32"]
TF_VAR_do_token=your_digitalocean_token_here
TF_VAR_ssh_fingerprint=your_ssh_key_fingerprint_here
